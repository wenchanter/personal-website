# Full URL of the CMS endpoint that returns published blog posts.
# Arrays and Payload-style { docs, hasNextPage, nextPage } responses are supported.
CMS_API_URL=

# Optional bearer token used only while building the static site.
CMS_API_TOKEN=

# Origins allowed to drive the live preview at /preview/, comma
# separated. Anything not listed is ignored by that page, so leaving it empty
# disables the preview entirely. Inlined at build time.
# Example: http://localhost:3000,https://cms.harrison.tech
NEXT_PUBLIC_CMS_ORIGIN=
